# Supabase — copy to `.env.local` (never commit secrets)
# Project Settings → API: https://supabase.com/dashboard/project/_/settings/api

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (dashboard label: "publishable" / "anon" / "public" — same value)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server/scripts only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URI — scripts only (npm run apply:signup-fix). Database → Connection string → URI
# SUPABASE_DB_URL=

# Auth redirects and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — inquiry + account confirmation (see docs/EMAIL_RESEND.md)
# Without RESEND_API_KEY, emails log to the server console (dev-safe).
# With a key, /api/email sends via Resend.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=SMOAC <onboarding@resend.dev>
# Production: EMAIL_FROM=SMOAC <noreply@yourdomain.com>

# Supabase Auth → enable Email OTP / Magic Link for low-friction inquiry signup
# Dashboard → Authentication → Providers → Email → confirm “Enable Email OTP” / Magic link
# Add redirect URL: {NEXT_PUBLIC_SITE_URL}/auth/callback

