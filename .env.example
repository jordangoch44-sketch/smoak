# Supabase — copy to `.env.local` (never commit secrets)
# Project Settings → API: https://supabase.com/dashboard/project/_/settings/api

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (dashboard label: "publishable" / "anon" / "public" — same value)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server/scripts only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token (dashboard → Account → Access Tokens)
# Needed only to push Auth email templates / SMTP via npm run apply:auth-emails
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
# SUPABASE_PROJECT_REF=your-project-ref

# Postgres URI — scripts only (npm run apply:signup-fix). Database → Connection string → URI
# SUPABASE_DB_URL=

# Auth redirects (magic link, email confirm, password reset)
# ONLY source for Supabase emailRedirectTo / redirectTo. Never use 0.0.0.0,
# localhost, or the Next.js bind address in this value.
#
# LAN iPhone testing (rebuild after changing):
#   NEXT_PUBLIC_SITE_URL=http://192.168.1.77:3000
# Production:
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# Also set Supabase → Authentication → URL Configuration Site URL to the SAME
# value (not http://0.0.0.0:3000). Add Redirect URLs:
#   {NEXT_PUBLIC_SITE_URL}/auth/callback
#   {NEXT_PUBLIC_SITE_URL}/login/reset-password
NEXT_PUBLIC_SITE_URL=http://192.168.1.77:3000

# Transactional email (Resend) — inquiry + join confirmations
# See docs/EMAIL_RESEND.md
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=SMOAC <onboarding@resend.dev>
# Production (verified domain):
# EMAIL_FROM=SMOAC <noreply@yourdomain.com>

# Stripe — specialist SMOAC Pro subscriptions
# Dashboard → Developers → API keys (use test keys first)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from webhook endpoint or `stripe listen`
# STRIPE_PRICE_PREMIUM=price_...   # from: node scripts/setup-stripe-products.mjs
# Webhook URL (production): https://smoac.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted

